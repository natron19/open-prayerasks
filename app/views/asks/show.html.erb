<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1">Your ask</h1>
    <p class="text-muted small mb-0">
      <%= link_to "← My asks", asks_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @ask.asking_for_label %> &middot; <%= @ask.anonymous? ? "Anonymous" : "Named" %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_ask_path(@ask), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", ask_path(@ask),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this ask and its reworded drafts?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card mb-4" style="max-width: 820px;">
  <div class="card-body">
    <p class="ask-text mb-3"><%= @ask.whats_going_on %></p>
    <dl class="row mb-0 small">
      <dt class="col-sm-4 text-muted">Asking for</dt>
      <dd class="col-sm-8"><%= @ask.asking_for_label %></dd>
      <dt class="col-sm-4 text-muted">The date</dt>
      <dd class="col-sm-8"><%= @ask.moment_on ? @ask.moment_on.strftime("%A, %B %-d, %Y") : "None given" %></dd>
      <dt class="col-sm-4 text-muted">Our word for this</dt>
      <dd class="col-sm-8"><%= @ask.vocabulary_label %></dd>
      <dt class="col-sm-4 text-muted">Who sees your name</dt>
      <dd class="col-sm-8 mb-0"><%= @ask.visibility_label %></dd>
    </dl>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "asks/draft_button", ask: @ask, label: "Help me say this", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    This reads only what you have written here, never who you are. It offers one gentler wording with every
    fact kept, a date to remember, ideas for practical help if you asked for it, and the quiet question you
    would be asked afterwards. It never writes a prayer. Typically takes 5&ndash;15 seconds.
  </p>
</div>

<% if @ask_drafts.any? %>
  <h2 class="h6 text-muted mb-2">Earlier wordings</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @ask_drafts.each do |draft| %>
      <li class="mb-2">
        <%= link_to ask_draft_path(@ask, draft) do %>
          <%= draft.generated_at ? "#{time_ago_in_words(draft.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if draft.completed? %>
          <span class="text-body"><%= draft.title %></span>
        <% else %>
          <span class="text-muted fst-italic"><%= draft.failed? ? "could not be used" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
